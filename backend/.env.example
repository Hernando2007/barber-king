# Servidor
PORT=3000
NODE_ENV=development
APP_NAME=Barber King
FRONTEND_URL=http://localhost:3000

# Base de datos (Supabase)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu-service-role-key

# Seguridad
JWT_SECRET=reemplaza-esto-por-un-secreto-largo-y-aleatorio

# Correo (recuperación de contraseña)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
EMAIL_USER=no-reply@example.com
EMAIL_PASS=tu-password-smtp

# Inteligencia artificial y Google
GROQ_API_KEY=tu-groq-api-key
# Modelo del chat de texto (opcional).
GROQ_MODELO_TEXTO=openai/gpt-oss-20b
# Zona horaria real de la barbería; el servidor de Render corre en UTC.
BARBERIA_ZONA_HORARIA=America/Bogota
GOOGLE_CLIENT_ID=tu-google-client-id.apps.googleusercontent.com

# Obligatorio: almacenamiento de fotos, diplomas e imágenes del chat.
# Sin estas tres variables cualquier subida responde 503, porque el disco
# de Render es efímero y una imagen guardada ahí desaparece al desplegar.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
